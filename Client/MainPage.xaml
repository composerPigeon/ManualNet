<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.MainPage"
             Title="ManualNet">
    <VerticalStackLayout Padding="30" Spacing="18" VerticalOptions="Center">
        <Label Text="ManualNet" Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1" />
        <Label Text="Sign in to continue, or create a new account."
               HorizontalTextAlignment="Center" />
        <Button Text="Log in" Clicked="OnLoginClicked" />
        <Button Text="Create account" Clicked="OnSignupClicked" />
    </VerticalStackLayout>
</ContentPage>
